# Run the backend from this directory. SQLite/local queue works without services.
DATABASE_URL=sqlite:///.data/contentforge.db
DATA_DIR=.data
REDIS_URL=
CHECKPOINT_URL=
FRONTEND_ORIGIN=http://localhost:3000
DEMO_AUTH=true
REGISTRATION_ENABLED=true
SECURE_COOKIES=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
SOURCE_HOSTS=www.iea.org,afdc.energy.gov,www.energy.gov
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0

# Password recovery mail (verified TLS required; empty host disables recovery).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
