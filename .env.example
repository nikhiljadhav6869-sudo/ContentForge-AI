# Docker Compose configuration. Generate a local database password with:
# python3 scripts/configure.py
POSTGRES_PASSWORD=
FRONTEND_ORIGIN=http://localhost:3000
DEMO_AUTH=true
REGISTRATION_ENABLED=true
WORKFLOW_DAILY_LIMIT=50
WORKFLOW_CONCURRENCY_LIMIT=2
# Optional global USD estimates; zero/zero leaves costs unavailable.
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0
SECURE_COOKIES=false
WEB_PORT=3000
API_PORT=8000
# Optional server-side providers. Never put these in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
SOURCE_HOSTS=www.iea.org,afdc.energy.gov,www.energy.gov

# Password recovery mail (verified TLS required; empty host disables recovery).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
