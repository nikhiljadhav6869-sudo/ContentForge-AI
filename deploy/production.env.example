# Generate a private .env.production using scripts/configure_production.py.
# Use a DNS hostname only: no scheme, port, path, or trailing dot.
DOMAIN=
POSTGRES_PASSWORD=
# Closed by default. Provision accounts with python -m app.create_account.
# Explicitly set true only when ready to admit public sign-ups.
PUBLIC_REGISTRATION=false
# Per-workspace, across demo and live modes. Daily zero pauses generation.
WORKFLOW_DAILY_LIMIT=50
WORKFLOW_CONCURRENCY_LIMIT=2
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0
# The production Compose override enforces HTTPS, secure cookies, and no guests.
# Add credentials for your chosen provider here before running preflight.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
SOURCE_HOSTS=www.iea.org,afdc.energy.gov,www.energy.gov

# Password recovery mail (verified TLS required; empty host disables recovery).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
