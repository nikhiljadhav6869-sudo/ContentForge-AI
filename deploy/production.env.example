# Generate a private .env.production using scripts/configure_production.py.
# Use a DNS hostname only: no scheme, port, path, or trailing dot.
DOMAIN=
POSTGRES_PASSWORD=
# The production Compose override enforces HTTPS, secure cookies, and no guests.
# Add credentials for your chosen provider here before running preflight.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
SOURCE_HOSTS=www.iea.org,afdc.energy.gov,www.energy.gov
