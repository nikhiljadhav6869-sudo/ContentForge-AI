# Docker Compose configuration. Generate a local database password with:
# python3 scripts/configure.py
POSTGRES_PASSWORD=
FRONTEND_ORIGIN=http://localhost:3000
DEMO_AUTH=true
SECURE_COOKIES=false
WEB_PORT=3000
API_PORT=8000
# Optional server-side providers. Never put these in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
SOURCE_HOSTS=www.iea.org,afdc.energy.gov,www.energy.gov
